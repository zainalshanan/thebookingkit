{
  "name": "thebookingkit",
  "private": true,
  "workspaces": [
    "packages/*",
    "registry/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:push": "npm -w @thebookingkit/db run db:push",
    "db:migrate": "npm -w @thebookingkit/db run db:migrate",
    "db:seed": "npm -w @thebookingkit/db run db:seed",
    "db:generate": "npm -w @thebookingkit/db run db:generate",
    "registry:build": "npx tsx scripts/build-registry.ts",
    "check:node-esm": "node scripts/check-node-esm.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "turbo": "^2.11.7",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.2"
}
