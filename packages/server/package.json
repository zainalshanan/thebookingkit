{
  "name": "@thebookingkit/server",
  "version": "0.5.0",
  "description": "Backend APIs, auth middleware, webhooks, notifications, and multi-tenant utilities for The Booking Kit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainalshanan/thebookingkit.git",
    "directory": "packages/server"
  },
  "homepage": "https://thebookingkit.dev",
  "keywords": [
    "thebookingkit",
    "booking",
    "scheduling",
    "server",
    "api"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.typetest.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@thebookingkit/core": "^0.5.0"
  },
  "peerDependencies": {
    "stripe": ">=17.0.0 <24.0.0"
  },
  "peerDependenciesMeta": {
    "stripe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "stripe": "^23.0.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.4"
  }
}
